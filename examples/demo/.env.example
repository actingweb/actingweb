# Copy this file to .env and fill in real values for a local run.
# Never commit a real .env — it is gitignored, and this file must stay
# placeholder-only.

# OAuth2 (Google by default; set OAUTH_PROVIDER=github for GitHub)
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_PROVIDER=google
OAUTH_SCOPE=openid email profile
OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token

# Public host this app is served from
APP_HOST_FQDN=localhost:5000
APP_HOST_PROTOCOL=http://

# Optional bot integration
APP_BOT_TOKEN=
APP_BOT_EMAIL=
APP_BOT_SECRET=
APP_BOT_ADMIN_ROOM=

# DynamoDB Local (see docker-compose.test.yml in the repository root)
AWS_DB_HOST=http://localhost:8000
AWS_DB_PREFIX=demo_actingweb
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1

# Test-only destructive cleanup endpoint (GET /nuke?secret=...). Leave unset
# to disable the endpoint; never set this in a production deployment.
NUKE_SECRET=

LOG_LEVEL=INFO
